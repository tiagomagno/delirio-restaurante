DATABASE_URL="mysql://user:password@host:3306/delirio_admin"
SESSION_SECRET="gere-um-valor-aleatorio-longo-por-ambiente"
ADMIN_SEED_EMAIL="admin@delirio.com.br"
ADMIN_SEED_PASSWORD="defina-uma-senha-forte"

# URL pública usada em canonical, sitemap.xml, robots.txt e Open Graph.
# Sem essa variável, assume https://delirio.com.br (domínio final de produção).
SITE_URL="https://delirio.com.br"

# Só defina SITE_ENV=production no ambiente que É o site final e indexável.
# Sem essa variável (ex: staging, preview, Coolify de teste), o site inteiro
# fica noindex/disallow automaticamente — evita indexar uma cópia de teste.
SITE_ENV="production"

# Envio de e-mail dos formulários (Fale Conosco, Eventos Corporativos, Trabalhe Conosco).
# Sem essas variáveis, os formulários continuam salvando normalmente no admin — só o
# envio de e-mail fica desativado (um aviso aparece no log do servidor).
SMTP_HOST="smtp.seuservidor.com.br"
SMTP_PORT="587"
SMTP_USER="usuario@delirio.com.br"
SMTP_PASS="defina-a-senha-do-smtp"
SMTP_FROM="Delírio Tropical <nao-responda@delirio.com.br>"

# Destinatário das mensagens do canal de Ouvidoria (anônimo, sem loja associada).
# Sem essa variável, as mensagens continuam salvando normalmente em /admin/ouvidoria —
# só não dispara e-mail de alerta.
OUVIDORIA_EMAIL="ouvidoria@delirio.com.br"
